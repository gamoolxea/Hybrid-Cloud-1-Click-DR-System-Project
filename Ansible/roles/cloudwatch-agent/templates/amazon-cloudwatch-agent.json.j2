{
  "agent": {
    "metrics_collection_interval": {{ cloudwatch_metrics_interval }},
    "run_as_user": "cwagent"
  },
  "metrics": {
    "namespace": "{{ cloudwatch_namespace }}",
    "metrics_collected": {
      "cpu": {
        "measurement": [
          "cpu_usage_idle",
          "cpu_usage_iowait",
          "cpu_usage_user",
          "cpu_usage_system"
        ],
        "metrics_collection_interval": {{ cloudwatch_metrics_interval }},
        "totalcpu": true,
        "append_dimensions": {
          "hostname": "{{ cloudwatch_hostname }}"
        }
      },
      "mem": {
        "measurement": [
          "mem_used_percent",
          "mem_available_percent",
          "mem_used",
          "mem_total"
        ],
        "metrics_collection_interval": {{ cloudwatch_metrics_interval }},
        "append_dimensions": {
          "hostname": "{{ cloudwatch_hostname }}"
        }
      },
      "disk": {
        "measurement": [
          "used_percent",
          "inodes_free"
        ],
        "metrics_collection_interval": {{ cloudwatch_metrics_interval }},
        "resources": [
          "/"
        ],
        "append_dimensions": {
          "hostname": "{{ cloudwatch_hostname }}"
        }
      },
      "netstat": {
        "measurement": [
          "tcp_established",
          "tcp_time_wait"
        ],
        "metrics_collection_interval": {{ cloudwatch_metrics_interval }},
        "append_dimensions": {
          "hostname": "{{ cloudwatch_hostname }}"
        }
      }{% if cloudwatch_enable_procstat %},
      "procstat": [
        {
          "pattern": "{{ cloudwatch_procstat_pattern }}",
          "measurement": [
            "pid_count"
          ],
          "metrics_collection_interval": {{ cloudwatch_metrics_interval }},
          "append_dimensions": {
            "hostname": "{{ cloudwatch_hostname }}"
          }
        }
      ]{% endif %}
    }
  }{% if cloudwatch_log_files | length > 0 %},
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
{% for log_file in cloudwatch_log_files %}
          {
            "file_path": "{{ log_file.path }}",
            "log_group_name": "{{ log_file.log_group }}",
            "log_stream_name": "{{ cloudwatch_hostname }}",
            "retention_in_days": {{ log_file.retention | default(7) }},
            "timezone": "Local"
          }{% if not loop.last %},{% endif %}
{% endfor %}
        ]
      }
    }
  }{% endif %}
}
