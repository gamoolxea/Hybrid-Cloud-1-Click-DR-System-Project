{
  "agent": {
    "metrics_collection_interval": 60,
    "run_as_user": "cwagent"
  },
  "metrics": {
    "namespace": "HybridDR/AWS",
    "append_dimensions": {
      "InstanceId": "${aws:InstanceId}",
      "InstanceType": "${aws:InstanceType}"
    },
    "metrics_collected": {
      "cpu": {
        "measurement": [
          "cpu_usage_idle",
          "cpu_usage_user",
          "cpu_usage_system",
          "cpu_usage_iowait"
        ],
        "metrics_collection_interval": 60,
        "totalcpu": true,
        "append_dimensions": {
          "hostname": "aws-haproxy"
        }
      },
      "mem": {
        "measurement": [
          "mem_used_percent",
          "mem_available_percent"
        ],
        "metrics_collection_interval": 60,
        "append_dimensions": {
          "hostname": "aws-haproxy"
        }
      },
      "disk": {
        "measurement": [
          "used_percent"
        ],
        "metrics_collection_interval": 60,
        "resources": [
          "/"
        ],
        "append_dimensions": {
          "hostname": "aws-haproxy"
        }
      },
      "netstat": {
        "measurement": [
          "tcp_established",
          "tcp_time_wait",
          "tcp_close_wait"
        ],
        "metrics_collection_interval": 60,
        "append_dimensions": {
          "hostname": "aws-haproxy"
        }
      },
      "procstat": [
        {
          "exe": "haproxy",
          "measurement": [
            "pid_count",
            "cpu_usage",
            "memory_rss"
          ],
          "metrics_collection_interval": 60,
          "append_dimensions": {
            "hostname": "aws-haproxy"
          }
        }
      ]
    }
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/haproxy/haproxy.log",
            "log_group_name": "/hybrid-dr/aws/haproxy",
            "log_stream_name": "{instance_id}",
            "retention_in_days": 7,
            "timezone": "Local"
          }
        ]
      }
    }
  }
}
